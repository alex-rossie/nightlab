{
  "permissions": {
    "allow": [
      "Bash(uv run nightlab train:*)",
      "Bash(uv run nightlab data:*)",
      "Bash(uv run nightlab render:*)",
      "Bash(uv run nightlab ledger-validate:*)",
      "Bash(uv run nightlab compare:*)",
      "Bash(uv run nightlab pr-comment:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv sync --extra rocm:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git checkout main)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run download:*)"
    ],
    "deny": [
      "Bash(gh api:*)",
      "Bash(gh label:*)",
      "Bash(gh workflow:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_gpu_label.py\""
          }
        ]
      }
    ]
  }
}
